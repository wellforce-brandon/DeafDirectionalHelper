<view:ThemedDialog x:Class="DeafDirectionalHelper.View.ProfileEditorWindow"
                   xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                   xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                   xmlns:view="clr-namespace:DeafDirectionalHelper.View"
                   Title="Edit Profile"
                   Width="460">

    <StackPanel Margin="24">
        <TextBlock Text="Profile name" FontSize="14" FontWeight="SemiBold"
                   Foreground="{StaticResource Text}" Margin="0,0,0,6"/>
        <TextBox x:Name="ProfileNameTextBox" Style="{StaticResource ThemedTextBox}"
                 AutomationProperties.Name="Profile name"/>

        <TextBlock Text="Game or app (optional)" FontSize="14" FontWeight="SemiBold"
                   Foreground="{StaticResource Text}" Margin="0,16,0,6"/>
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <TextBox x:Name="ExePathTextBox" Style="{StaticResource ThemedTextBox}"
                     IsReadOnly="True" AutomationProperties.Name="Game or app path"/>
            <Button Grid.Column="1" Content="Browse…" Style="{StaticResource SecondaryButton}"
                    Click="Browse_Click" Margin="10,0,0,0" MinHeight="46"/>
        </Grid>

        <StackPanel x:Name="AdditionalSection" Margin="0,16,0,0">
            <TextBlock Text="Also matches (optional)" FontSize="14" FontWeight="SemiBold"
                       Foreground="{StaticResource Text}"/>
            <TextBlock Text="Some games run under a different exe than their launcher (anti-cheat wrappers). Any of these also activate this profile."
                       FontSize="12.5" Foreground="{StaticResource TextSecondary}"
                       TextWrapping="Wrap" Margin="0,4,0,8"/>
            <StackPanel x:Name="AdditionalList"/>
            <Button Content="Add another .exe…" Style="{StaticResource SecondaryButton}"
                    HorizontalAlignment="Left" MinHeight="38" Click="AddAdditional_Click"/>
        </StackPanel>

        <TextBlock x:Name="InfoText" FontSize="13" Foreground="{StaticResource TextSecondary}"
                   TextWrapping="Wrap" Margin="0,10,0,20"/>

        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
            <Button Content="Cancel" Style="{StaticResource SecondaryButton}"
                    IsCancel="True" Margin="0,0,10,0"/>
            <Button x:Name="OkButton" Content="Save" Style="{StaticResource PrimaryButton}"
                    Click="OK_Click" IsDefault="True" MinWidth="130"/>
        </StackPanel>
    </StackPanel>
</view:ThemedDialog>
