<Window x:Class="DeafDirectionalHelper.View.SignalDoctorWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Signal doctor"
        Width="640" SizeToContent="Height"
        Background="{StaticResource Bg}"
        WindowStartupLocation="CenterScreen"
        ResizeMode="NoResize"
        ShowInTaskbar="True"
        Topmost="True">

    <StackPanel>

        <!-- Amber warning banner -->
        <Border Background="{StaticResource DoctorBannerBg}"
                BorderBrush="{StaticResource DoctorBannerBorder}" BorderThickness="0,0,0,1"
                Padding="20,14">
            <StackPanel Orientation="Horizontal">
                <TextBlock Text="&#9888;" FontSize="20" Foreground="{StaticResource Warn}"
                           VerticalAlignment="Top" Margin="0,0,12,0"/>
                <TextBlock TextWrapping="Wrap" FontSize="13.5" MaxWidth="540"
                           Foreground="{StaticResource DoctorBannerText}">
                    <Run Text="Overlay armed but silent." FontWeight="Bold"
                         Foreground="{StaticResource DoctorBannerStrong}"/>
                    <Run x:Name="BannerDetail"
                         Text="game.exe has been playing audio for 12 s, but none of it reached the device you're listening to."/>
                </TextBlock>
            </StackPanel>
        </Border>

        <StackPanel Margin="20,16,20,0">

            <!-- Selected (silent) device row -->
            <Border Background="{StaticResource Panel}" BorderBrush="{StaticResource Interactive}"
                    BorderThickness="2" CornerRadius="10" Padding="14" Margin="0,0,0,10">
                <StackPanel>
                    <Grid>
                        <StackPanel Orientation="Horizontal">
                            <ContentControl Style="{StaticResource Pill}" Content="LISTENING HERE"/>
                            <ContentControl x:Name="SelectedChannelsChip" Style="{StaticResource Pill}"
                                            Content="8 CH" Margin="8,0,0,0"
                                            Background="{StaticResource Raised}" Foreground="{StaticResource TextSecondary}"/>
                        </StackPanel>
                        <TextBlock x:Name="SelectedSilentLabel" Text="silent 12 s"
                                   HorizontalAlignment="Right" VerticalAlignment="Center"
                                   FontSize="12.5" Foreground="{StaticResource TextMuted}"/>
                    </Grid>
                    <TextBlock x:Name="SelectedDeviceLabel" Text="Device name"
                               Style="{StaticResource RowLabelText}" FontWeight="SemiBold" Margin="0,10,0,8"/>
                    <Border Height="12" CornerRadius="6" Background="{StaticResource Bg}" ClipToBounds="True">
                        <Border x:Name="SelectedMeterFill" Height="12" CornerRadius="6" Width="0"
                                HorizontalAlignment="Left" Background="{StaticResource Interactive}"/>
                    </Border>
                </StackPanel>
            </Border>

            <!-- Candidate (game audio) device row -->
            <Border Background="{StaticResource Panel}" BorderBrush="{StaticResource Success}"
                    BorderThickness="2" CornerRadius="10" Padding="14">
                <StackPanel>
                    <Grid>
                        <StackPanel Orientation="Horizontal">
                            <ContentControl Style="{StaticResource Pill}" Content="GAME AUDIO IS HERE"
                                            Background="{StaticResource Success}" Foreground="{StaticResource OnSuccess}"/>
                            <ContentControl x:Name="CandidateChannelsChip" Style="{StaticResource Pill}"
                                            Content="2 CH" Margin="8,0,0,0"
                                            Background="{StaticResource Raised}" Foreground="{StaticResource TextSecondary}"/>
                        </StackPanel>
                        <TextBlock x:Name="CandidateSessionLabel" Text="&#9679; game.exe session"
                                   HorizontalAlignment="Right" VerticalAlignment="Center"
                                   FontSize="12.5" Foreground="{StaticResource Success}"/>
                    </Grid>
                    <TextBlock x:Name="CandidateDeviceLabel" Text="Device name"
                               Style="{StaticResource RowLabelText}" FontWeight="SemiBold" Margin="0,10,0,8"/>
                    <Border Height="12" CornerRadius="6" Background="{StaticResource Bg}" ClipToBounds="True">
                        <Border x:Name="CandidateMeterFill" Height="12" CornerRadius="6" Width="0"
                                HorizontalAlignment="Left" Background="{StaticResource Success}"/>
                    </Border>
                    <Grid Margin="0,12,0,0">
                        <TextBlock x:Name="StereoNote" Text="left / right only on 2 channels"
                                   FontSize="12.5" Foreground="{StaticResource Warn}"
                                   VerticalAlignment="Center" Visibility="Collapsed"/>
                        <Button x:Name="ListenHereButton" Content="Listen here instead"
                                Style="{StaticResource PrimaryButton}"
                                Background="{StaticResource Success}" Foreground="{StaticResource OnSuccess}"
                                HorizontalAlignment="Right" Click="ListenHere_Click" IsDefault="True"/>
                    </Grid>
                </StackPanel>
            </Border>

        </StackPanel>

        <!-- Footer -->
        <Border Background="{StaticResource FooterBg}" BorderBrush="{StaticResource Hairline}"
                BorderThickness="0,1,0,0" Padding="20,14" Margin="0,16,0,0">
            <StackPanel>
                <Grid>
                    <StackPanel Orientation="Horizontal">
                        <Button x:Name="FollowGameButton" Content="Switch to 'Follow the game'"
                                Style="{StaticResource SecondaryButton}"
                                BorderBrush="{StaticResource Interactive}" Foreground="{StaticResource Interactive}"
                                Click="FollowGame_Click"/>
                    </StackPanel>
                    <Button Content="7.1 routing guide" Style="{StaticResource LinkButton}"
                            HorizontalAlignment="Right" VerticalAlignment="Center"
                            Click="RoutingGuide_Click"/>
                </Grid>
                <TextBlock x:Name="FollowGameHelper"
                           Text="tracks game.exe wherever it plays, forever"
                           Style="{StaticResource RowHelperText}" Margin="2,8,0,0"/>
            </StackPanel>
        </Border>

    </StackPanel>
</Window>
