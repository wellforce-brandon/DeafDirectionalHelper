<view:ThemedDialog x:Class="DeafDirectionalHelper.View.HotkeysWindow"
                   xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                   xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                   xmlns:view="clr-namespace:DeafDirectionalHelper.View"
                   Title="Hotkeys"
                   Width="400">

    <StackPanel Margin="24">
        <TextBlock Text="Hotkeys" FontSize="17" FontWeight="Bold"
                   Foreground="{StaticResource Text}" Margin="0,0,0,14"/>

        <StackPanel x:Name="HotkeyRows"/>

        <TextBlock Text="Hotkeys are global — they work while a game has focus."
                   FontSize="12.5" Foreground="{StaticResource TextMuted}"
                   Margin="0,10,0,16" TextWrapping="Wrap"/>

        <Button Content="Done" Style="{StaticResource PrimaryButton}"
                HorizontalAlignment="Right" MinWidth="110"
                IsDefault="True" IsCancel="True"/>
    </StackPanel>
</view:ThemedDialog>
