<UserControl x:Class="DeafDirectionalHelper.View.Settings.GeneralPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <StackPanel>
        <TextBlock Text="General" Style="{StaticResource PageTitleText}"/>
        <TextBlock Text="Startup, monitor and logging." Style="{StaticResource PageSubtitleText}" Margin="0,4,0,16"/>

        <Border Style="{StaticResource SettingsRow}">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <StackPanel VerticalAlignment="Center">
                    <TextBlock Text="Start minimized to tray" Style="{StaticResource RowLabelText}"/>
                    <TextBlock Text="Skip the settings window on launch." Style="{StaticResource RowHelperText}"/>
                </StackPanel>
                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock x:Name="MinimizedStateLabel" Text="Off" Style="{StaticResource ToggleStateOffText}"
                               VerticalAlignment="Center" Margin="0,0,10,0"/>
                    <CheckBox x:Name="MinimizedToggle" Style="{StaticResource ToggleSwitch}"
                              AutomationProperties.Name="Start minimized to tray"
                              Checked="MinimizedToggle_Changed" Unchecked="MinimizedToggle_Changed"/>
                </StackPanel>
            </Grid>
        </Border>

        <Border Style="{StaticResource SettingsRow}">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <StackPanel VerticalAlignment="Center">
                    <TextBlock Text="Start with Windows" Style="{StaticResource RowLabelText}"/>
                    <TextBlock Text="Launches automatically when you sign in." Style="{StaticResource RowHelperText}"/>
                </StackPanel>
                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock x:Name="StartupStateLabel" Text="Off" Style="{StaticResource ToggleStateOffText}"
                               VerticalAlignment="Center" Margin="0,0,10,0"/>
                    <CheckBox x:Name="StartupToggle" Style="{StaticResource ToggleSwitch}"
                              AutomationProperties.Name="Start with Windows"
                              Checked="StartupToggle_Changed" Unchecked="StartupToggle_Changed"/>
                </StackPanel>
            </Grid>
        </Border>

        <Border Style="{StaticResource SettingsRow}">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <StackPanel VerticalAlignment="Center">
                    <TextBlock Text="Target monitor" Style="{StaticResource RowLabelText}"/>
                    <TextBlock Text="Which screen the overlays appear on." Style="{StaticResource RowHelperText}"/>
                </StackPanel>
                <ComboBox x:Name="MonitorCombo" Grid.Column="1" Style="{StaticResource ThemedComboBox}"
                          MinWidth="280" VerticalAlignment="Center"
                          SelectionChanged="MonitorCombo_Changed"
                          AutomationProperties.Name="Target monitor"/>
            </Grid>
        </Border>

        <TextBlock Text="AUDIO EVENT LOGGING" Style="{StaticResource SectionLabelText}" Margin="0,18,0,4"/>

        <Border Style="{StaticResource SettingsRow}">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <StackPanel VerticalAlignment="Center">
                    <TextBlock Text="Log audio events" Style="{StaticResource RowLabelText}"/>
                    <TextBlock Text="Writes level snapshots for troubleshooting." Style="{StaticResource RowHelperText}"/>
                </StackPanel>
                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock x:Name="LoggingStateLabel" Text="Off" Style="{StaticResource ToggleStateOffText}"
                               VerticalAlignment="Center" Margin="0,0,10,0"/>
                    <CheckBox x:Name="LoggingToggle" Style="{StaticResource ToggleSwitch}"
                              AutomationProperties.Name="Log audio events"
                              Checked="LoggingToggle_Changed" Unchecked="LoggingToggle_Changed"/>
                </StackPanel>
            </Grid>
        </Border>

        <StackPanel x:Name="LoggingRows">
            <Border Style="{StaticResource SettingsRow}">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="Keep logs" Style="{StaticResource RowLabelText}" VerticalAlignment="Center"/>
                    <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                        <ListBox x:Name="RetentionSegmented" Style="{StaticResource SegmentedControl}"
                                 SelectionChanged="RetentionSegmented_Changed"
                                 AutomationProperties.Name="Log retention type">
                            <ListBoxItem Content="By size" Tag="Size"/>
                            <ListBoxItem Content="By age" Tag="Date"/>
                        </ListBox>
                        <ComboBox x:Name="RetentionSizeCombo" Style="{StaticResource ThemedComboBox}"
                                  MinWidth="110" Margin="10,0,0,0"
                                  SelectionChanged="RetentionSizeCombo_Changed"
                                  AutomationProperties.Name="Log size limit">
                            <ComboBoxItem Content="50 MB" Tag="50"/>
                            <ComboBoxItem Content="100 MB" Tag="100"/>
                            <ComboBoxItem Content="250 MB" Tag="250"/>
                            <ComboBoxItem Content="500 MB" Tag="500"/>
                        </ComboBox>
                        <ComboBox x:Name="RetentionDaysCombo" Style="{StaticResource ThemedComboBox}"
                                  MinWidth="110" Margin="10,0,0,0" Visibility="Collapsed"
                                  SelectionChanged="RetentionDaysCombo_Changed"
                                  AutomationProperties.Name="Log age limit">
                            <ComboBoxItem Content="3 days" Tag="3"/>
                            <ComboBoxItem Content="7 days" Tag="7"/>
                            <ComboBoxItem Content="14 days" Tag="14"/>
                            <ComboBoxItem Content="30 days" Tag="30"/>
                        </ComboBox>
                    </StackPanel>
                </Grid>
            </Border>

            <Border Style="{StaticResource SettingsRow}">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock x:Name="LogSizeLabel" Text="Log size: N/A" Style="{StaticResource RowHelperText}"
                               VerticalAlignment="Center"/>
                    <StackPanel Grid.Column="1" Orientation="Horizontal">
                        <Button Content="Open logs" Style="{StaticResource SecondaryButton}"
                                Click="OpenLogs_Click" Margin="0,0,10,0"/>
                        <Button Content="Clear logs" Style="{StaticResource SecondaryButton}"
                                Click="ClearLogs_Click"/>
                    </StackPanel>
                </Grid>
            </Border>
        </StackPanel>
    </StackPanel>
</UserControl>
