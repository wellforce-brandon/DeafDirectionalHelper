<Window x:Class="DeafDirectionalHelper.View.Settings.SettingsShell"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="DeafDirectionalHelper"
        Width="880" Height="640"
        MinWidth="820" MinHeight="600"
        Background="{StaticResource Bg}"
        WindowStartupLocation="CenterScreen">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="212"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- Left rail -->
        <Border Grid.Row="0" Grid.Column="0" Background="{StaticResource Panel}"
                BorderBrush="{StaticResource Hairline}" BorderThickness="0,0,1,0">
            <Grid Margin="10,14">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <!-- Header -->
                <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="6,0,0,14">
                    <TextBlock Text="Settings" FontSize="15" FontWeight="Bold"
                               Foreground="{StaticResource Text}" VerticalAlignment="Center"/>
                    <ContentControl x:Name="ProfilePill" Style="{StaticResource Pill}"
                                    Content="★ Default" Margin="10,0,0,0" VerticalAlignment="Center"/>
                </StackPanel>

                <!-- Nav -->
                <ListBox x:Name="NavList" Grid.Row="1" Style="{StaticResource NavRail}"
                         SelectionChanged="NavList_SelectionChanged">
                    <ListBoxItem Content="Overlay"/>
                    <ListBoxItem Content="Audio &amp; device"/>
                    <ListBoxItem Content="Profiles"/>
                    <ListBoxItem Content="General"/>
                    <ListBoxItem Content="Hotkeys"/>
                    <ListBoxItem Content="About"/>
                </ListBox>

                <!-- Rail footer: live status -->
                <Border Grid.Row="2" BorderBrush="{StaticResource Hairline}" BorderThickness="0,1,0,0"
                        Padding="6,12,6,0">
                    <StackPanel>
                        <StackPanel Orientation="Horizontal">
                            <Ellipse x:Name="StatusDot" Width="10" Height="10"
                                     Fill="{StaticResource Success}" VerticalAlignment="Center"/>
                            <TextBlock x:Name="StatusText" Text="Overlay running"
                                       FontSize="12.5" Foreground="{StaticResource TextSecondary}"
                                       Margin="8,0,0,0" TextWrapping="Wrap" MaxWidth="160"/>
                        </StackPanel>
                        <TextBlock Text="Ctrl+Shift+S opens this window"
                                   FontFamily="{StaticResource MonoFont}" FontSize="11"
                                   Foreground="{StaticResource TextMuted}" Margin="0,8,0,0"/>
                    </StackPanel>
                </Border>
            </Grid>
        </Border>

        <!-- Page host -->
        <ScrollViewer Grid.Row="0" Grid.Column="1" VerticalScrollBarVisibility="Auto"
                      Padding="26,20,26,10" Focusable="False">
            <ContentControl x:Name="PageHost" Focusable="False"/>
        </ScrollViewer>

        <!-- Footer bar -->
        <Border Grid.Row="1" Grid.Column="0" Grid.ColumnSpan="2"
                Background="{StaticResource FooterBg}"
                BorderBrush="{StaticResource Hairline}" BorderThickness="0,1,0,0"
                Padding="26,14">
            <Grid>
                <StackPanel Orientation="Horizontal">
                    <Button x:Name="ResetPositionsButton" Content="Reset positions"
                            Style="{StaticResource SecondaryButton}" Click="ResetPositions_Click"/>
                    <TextBlock Text="Ctrl+Shift+P" FontFamily="{StaticResource MonoFont}" FontSize="11"
                               Foreground="{StaticResource TextMuted}" VerticalAlignment="Center"
                               Margin="10,0,0,0"/>
                </StackPanel>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                    <Button x:Name="ExitAppButton" Content="Exit app…"
                            Style="{StaticResource DangerLinkButton}"
                            VerticalAlignment="Center" Margin="0,0,20,0" Click="ExitApp_Click"/>
                    <Button x:Name="HideWindowButton" Content="Hide window" MinWidth="130"
                            Style="{StaticResource PrimaryButton}" Click="HideWindow_Click"/>
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</Window>
