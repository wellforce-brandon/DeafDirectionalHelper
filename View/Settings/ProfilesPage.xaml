<UserControl x:Class="DeafDirectionalHelper.View.Settings.ProfilesPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <StackPanel>
        <TextBlock Text="Profiles" Style="{StaticResource PageTitleText}"/>
        <TextBlock Text="Per-game overlay setups that switch automatically."
                   Style="{StaticResource PageSubtitleText}" Margin="0,4,0,16"/>

        <TextBlock x:Name="PausedNote"
                   Text="Auto-switching is paused while this window is open."
                   FontSize="12.5" Foreground="{StaticResource Warn}" Margin="0,0,0,10"
                   Visibility="Collapsed"/>

        <Border Style="{StaticResource SettingsRow}">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <TextBlock Text="When a profiled game starts:" Style="{StaticResource RowLabelText}"
                           VerticalAlignment="Center"/>
                <ListBox x:Name="BehaviorSegmented" Grid.Column="1" Style="{StaticResource SegmentedControl}"
                         SelectionChanged="BehaviorSegmented_Changed"
                         AutomationProperties.Name="Profile switch behavior">
                    <ListBoxItem Content="Switch silently" Tag="Silent"/>
                    <ListBoxItem Content="Switch + toast" Tag="SwitchWithToast"/>
                    <ListBoxItem Content="Ask first" Tag="AskFirst"/>
                </ListBox>
            </Grid>
        </Border>

        <Border Style="{StaticResource SettingsRow}">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <StackPanel VerticalAlignment="Center">
                    <TextBlock Text="Offer a profile when an unknown game makes sound"
                               Style="{StaticResource RowLabelText}"/>
                    <TextBlock Text="A toast appears once per game; Ignore hides it forever."
                               Style="{StaticResource RowHelperText}"/>
                </StackPanel>
                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock x:Name="OfferStateLabel" Text="On" Style="{StaticResource ToggleStateOnText}"
                               VerticalAlignment="Center" Margin="0,0,10,0"/>
                    <CheckBox x:Name="OfferToggle" Style="{StaticResource ToggleSwitch}"
                              AutomationProperties.Name="Offer a profile for unknown games"
                              Checked="OfferToggle_Changed" Unchecked="OfferToggle_Changed"/>
                </StackPanel>
            </Grid>
        </Border>

        <UniformGrid x:Name="CardGrid" Columns="2" Margin="0,16,0,0"/>
    </StackPanel>
</UserControl>
