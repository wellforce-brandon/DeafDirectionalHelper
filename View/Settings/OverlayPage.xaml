<UserControl x:Class="DeafDirectionalHelper.View.Settings.OverlayPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <StackPanel>
        <TextBlock Text="Overlay" Style="{StaticResource PageTitleText}"/>
        <TextBlock Text="What the sound indicators look like and how they react."
                   Style="{StaticResource PageSubtitleText}" Margin="0,4,0,16"/>

        <!-- 1. Live preview strip -->
        <Border Background="{StaticResource Panel}" BorderBrush="{StaticResource Border}"
                BorderThickness="1" CornerRadius="8" Padding="16,12" Margin="0,0,0,16">
            <StackPanel Orientation="Horizontal">
                <Border Width="180" Height="74" Background="#080A0C" CornerRadius="5"
                        BorderBrush="{StaticResource Hairline}" BorderThickness="1">
                    <Grid>
                        <TextBlock Text="LIVE" FontFamily="{StaticResource MonoFont}" FontSize="9"
                                   Foreground="#4A5158" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        <Border x:Name="PreviewLeftMeter" Width="9" Height="0" CornerRadius="2"
                                HorizontalAlignment="Left" VerticalAlignment="Bottom"
                                Margin="12,0,0,4" Background="Transparent"/>
                        <Border x:Name="PreviewRightMeter" Width="9" Height="0" CornerRadius="2"
                                HorizontalAlignment="Right" VerticalAlignment="Bottom"
                                Margin="0,0,12,4" Background="Transparent"/>
                    </Grid>
                </Border>
                <StackPanel VerticalAlignment="Center" Margin="16,0,0,0">
                    <TextBlock Text="Preview reacts to real audio" Style="{StaticResource RowLabelText}" FontWeight="SemiBold"/>
                    <TextBlock Text="Play any sound to see the meters move with your current sensitivity and colors."
                               Style="{StaticResource RowHelperText}" Margin="0,4,0,0" MaxWidth="330"/>
                </StackPanel>
            </StackPanel>
        </Border>

        <!-- 2. Show sound indicators -->
        <Border Style="{StaticResource SettingsRow}">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <StackPanel VerticalAlignment="Center">
                    <TextBlock Text="Show sound indicators" Style="{StaticResource RowLabelText}"/>
                    <TextBlock Text="Master switch for all overlays." Style="{StaticResource RowHelperText}"/>
                </StackPanel>
                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock x:Name="EnabledStateLabel" Text="On" Style="{StaticResource ToggleStateOnText}"
                               VerticalAlignment="Center" Margin="0,0,10,0"/>
                    <CheckBox x:Name="EnabledToggle" Style="{StaticResource ToggleSwitch}"
                              AutomationProperties.Name="Show sound indicators"
                              Checked="EnabledToggle_Changed" Unchecked="EnabledToggle_Changed"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- 3. Overlay style -->
        <Border Style="{StaticResource SettingsRow}">
            <StackPanel>
                <TextBlock Text="Overlay style" Style="{StaticResource RowLabelText}"/>
                <TextBlock Text="Switch anytime with Ctrl+Shift+M" Style="{StaticResource RowHelperText}" Margin="0,2,0,10"/>
                <WrapPanel>
                    <RadioButton x:Name="StyleSideBars" Content="Side bars" Tag="SideBars" GroupName="OverlayStyle"
                                 Style="{StaticResource RadioPill}" Margin="0,0,8,8" Checked="StyleRadio_Checked"
                                 AutomationProperties.Name="Overlay style Side bars"/>
                    <RadioButton x:Name="StyleRadarRing" Content="Radar ring" Tag="RadarRing" GroupName="OverlayStyle"
                                 Style="{StaticResource RadioPill}" Margin="0,0,8,8" Checked="StyleRadio_Checked"
                                 AutomationProperties.Name="Overlay style Radar ring"/>
                    <RadioButton x:Name="StyleRingPing" Content="Ring ping" Tag="RingPing" GroupName="OverlayStyle"
                                 Style="{StaticResource RadioPill}" Margin="0,0,8,8" Checked="StyleRadio_Checked"
                                 AutomationProperties.Name="Overlay style Ring ping"/>
                    <RadioButton x:Name="StyleCompass" Content="Compass" Tag="CompassStrip" GroupName="OverlayStyle"
                                 Style="{StaticResource RadioPill}" Margin="0,0,8,8" Checked="StyleRadio_Checked"
                                 AutomationProperties.Name="Overlay style Compass"/>
                    <RadioButton x:Name="StyleEdgeGlow" Content="Edge glow" Tag="EdgeGlow" GroupName="OverlayStyle"
                                 Style="{StaticResource RadioPill}" Margin="0,0,8,8" Checked="StyleRadio_Checked"
                                 AutomationProperties.Name="Overlay style Edge glow"/>
                </WrapPanel>
                <StackPanel x:Name="PairRow" Orientation="Horizontal" Margin="0,6,0,0">
                    <CheckBox x:Name="PairToggle" Style="{StaticResource ToggleSwitch}"
                              AutomationProperties.Name="Pair with side bars"
                              Checked="PairToggle_Changed" Unchecked="PairToggle_Changed"/>
                    <TextBlock Text="Pair with side bars" Style="{StaticResource ControlText}"
                               VerticalAlignment="Center" Margin="10,0,0,0"/>
                </StackPanel>
            </StackPanel>
        </Border>

        <!-- 4. Only show while sound plays -->
        <Border Style="{StaticResource SettingsRow}">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <StackPanel VerticalAlignment="Center">
                    <TextBlock Text="Only show while sound plays" Style="{StaticResource RowLabelText}"/>
                    <TextBlock Text="Indicators fade out in silence instead of staying white."
                               Style="{StaticResource RowHelperText}"/>
                </StackPanel>
                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock x:Name="TransparentStateLabel" Text="Off" Style="{StaticResource ToggleStateOffText}"
                               VerticalAlignment="Center" Margin="0,0,10,0"/>
                    <CheckBox x:Name="TransparentToggle" Style="{StaticResource ToggleSwitch}"
                              AutomationProperties.Name="Only show while sound plays"
                              Checked="TransparentToggle_Changed" Unchecked="TransparentToggle_Changed"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- 5. Sensitivity -->
        <Border Style="{StaticResource SettingsRow}">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="220"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <StackPanel VerticalAlignment="Center">
                    <TextBlock Text="Sensitivity" Style="{StaticResource RowLabelText}"/>
                    <TextBlock Text="How easily indicators light up." Style="{StaticResource RowHelperText}"/>
                </StackPanel>
                <Slider x:Name="SensitivitySlider" Grid.Column="1" Style="{StaticResource ThemedSlider}"
                        Minimum="0.1" Maximum="3.0" SmallChange="0.1" LargeChange="0.1"
                        TickFrequency="0.1" IsSnapToTickEnabled="True" VerticalAlignment="Center"
                        Margin="0,0,14,0" ValueChanged="SensitivitySlider_Changed"
                        AutomationProperties.Name="Sensitivity"/>
                <ContentControl x:Name="SensitivityChip" Grid.Column="2" Style="{StaticResource ValueChip}"
                                Content="1.0" VerticalAlignment="Center"/>
            </Grid>
        </Border>

        <!-- 6. Noise floor -->
        <Border Style="{StaticResource SettingsRow}">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="220"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <StackPanel VerticalAlignment="Center">
                    <TextBlock Text="Noise floor" Style="{StaticResource RowLabelText}"/>
                    <TextBlock Text="Ignore sounds quieter than this." Style="{StaticResource RowHelperText}"/>
                </StackPanel>
                <Slider x:Name="ThresholdSlider" Grid.Column="1" Style="{StaticResource ThemedSlider}"
                        Minimum="0" Maximum="0.30" SmallChange="0.01" LargeChange="0.01"
                        TickFrequency="0.01" IsSnapToTickEnabled="True" VerticalAlignment="Center"
                        Margin="0,0,14,0" ValueChanged="ThresholdSlider_Changed"
                        AutomationProperties.Name="Noise floor"/>
                <ContentControl x:Name="ThresholdChip" Grid.Column="2" Style="{StaticResource ValueChip}"
                                Content="0.05" VerticalAlignment="Center"/>
            </Grid>
        </Border>

        <!-- 7. Filter self sounds -->
        <Border Style="{StaticResource SettingsRow}">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <StackPanel VerticalAlignment="Center">
                    <TextBlock Text="Filter self sounds" Style="{StaticResource RowLabelText}"/>
                    <TextBlock Text="Hides audio equal in both ears — your own steps."
                               Style="{StaticResource RowHelperText}"/>
                </StackPanel>
                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock x:Name="BalancedStateLabel" Text="Off" Style="{StaticResource ToggleStateOffText}"
                               VerticalAlignment="Center" Margin="0,0,10,0"/>
                    <CheckBox x:Name="BalancedToggle" Style="{StaticResource ToggleSwitch}"
                              AutomationProperties.Name="Filter self sounds"
                              Checked="BalancedToggle_Changed" Unchecked="BalancedToggle_Changed"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- 7b. Directional focus -->
        <Border Style="{StaticResource SettingsRow}">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="220"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <StackPanel VerticalAlignment="Center">
                    <TextBlock Text="Directional focus" Style="{StaticResource RowLabelText}"/>
                    <TextBlock Text="Games leak a right-side sound into the left channel too. Higher = only the louder side lights up."
                               Style="{StaticResource RowHelperText}"/>
                </StackPanel>
                <Slider x:Name="FocusSlider" Grid.Column="1" Style="{StaticResource ThemedSlider}"
                        Minimum="0" Maximum="100" SmallChange="5" LargeChange="5"
                        TickFrequency="5" IsSnapToTickEnabled="True" VerticalAlignment="Center"
                        Margin="0,0,14,0" ValueChanged="FocusSlider_Changed"
                        AutomationProperties.Name="Directional focus"/>
                <ContentControl x:Name="FocusChip" Grid.Column="2" Style="{StaticResource ValueChip}"
                                Content="50 %" VerticalAlignment="Center"/>
            </Grid>
        </Border>

        <!-- 8. Overlay strength -->
        <Border Style="{StaticResource SettingsRow}">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="220"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <StackPanel VerticalAlignment="Center">
                    <TextBlock Text="Overlay strength" Style="{StaticResource RowLabelText}"/>
                    <TextBlock Text="Maximum opacity of the indicators." Style="{StaticResource RowHelperText}"/>
                </StackPanel>
                <Slider x:Name="StrengthSlider" Grid.Column="1" Style="{StaticResource ThemedSlider}"
                        Minimum="0.3" Maximum="1.0" SmallChange="0.05" LargeChange="0.05"
                        TickFrequency="0.05" IsSnapToTickEnabled="True" VerticalAlignment="Center"
                        Margin="0,0,14,0" ValueChanged="StrengthSlider_Changed"
                        AutomationProperties.Name="Overlay strength"/>
                <ContentControl x:Name="StrengthChip" Grid.Column="2" Style="{StaticResource ValueChip}"
                                Content="100 %" VerticalAlignment="Center"/>
            </Grid>
        </Border>

        <!-- 9. Color scale -->
        <Border Style="{StaticResource SettingsRow}">
            <StackPanel>
                <TextBlock Text="Color scale" Style="{StaticResource RowLabelText}"/>
                <TextBlock Text="Thermal, Ice and Violet are colorblind-safe. Loudness is also shown by fill amount and a peak mark — never by hue alone."
                           Style="{StaticResource RowHelperText}" Margin="0,2,0,10"/>
                <WrapPanel x:Name="ScalePanel"/>
            </StackPanel>
        </Border>

        <!-- 10. Frame rate -->
        <Border Style="{StaticResource SettingsRow}">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <StackPanel VerticalAlignment="Center">
                    <TextBlock Text="Frame rate" Style="{StaticResource RowLabelText}"/>
                    <TextBlock Text="How smoothly indicators animate. Match your monitor's refresh rate."
                               Style="{StaticResource RowHelperText}" MaxWidth="330"/>
                </StackPanel>
                <ListBox x:Name="FpsSegmented" Grid.Column="1" Style="{StaticResource SegmentedControl}"
                         VerticalAlignment="Center" SelectionChanged="FpsSegmented_Changed"
                         AutomationProperties.Name="Frame rate">
                    <ListBoxItem Content="30" Tag="30"/>
                    <ListBoxItem Content="60" Tag="60"/>
                    <ListBoxItem Content="144" Tag="144"/>
                    <ListBoxItem Content="240" Tag="240"/>
                </ListBox>
            </Grid>
        </Border>

        <!-- 11. SIZE & POSITION -->
        <TextBlock Text="SIZE &amp; POSITION" Style="{StaticResource SectionLabelText}" Margin="0,18,0,4"/>

        <Border Style="{StaticResource SettingsRow}">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="220"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <StackPanel VerticalAlignment="Center">
                    <TextBlock Text="Overlay size" Style="{StaticResource RowLabelText}"/>
                    <TextBlock Text="Scales the whole overlay. 100 % is the designed size."
                               Style="{StaticResource RowHelperText}"/>
                </StackPanel>
                <Slider x:Name="SizeSlider" Grid.Column="1" Style="{StaticResource ThemedSlider}"
                        Minimum="50" Maximum="200" SmallChange="5" LargeChange="5"
                        TickFrequency="5" IsSnapToTickEnabled="True" VerticalAlignment="Center"
                        Margin="0,0,14,0" ValueChanged="SizeSlider_Changed"
                        AutomationProperties.Name="Overlay size"/>
                <ContentControl x:Name="SizeChip" Grid.Column="2" Style="{StaticResource ValueChip}"
                                Content="100 %" VerticalAlignment="Center"/>
            </Grid>
        </Border>

        <!-- Side bars rows -->
        <StackPanel x:Name="SideBarsRows">
            <Border Style="{StaticResource SettingsRow}">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="220"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="Bar width" Style="{StaticResource RowLabelText}" VerticalAlignment="Center"/>
                    <Slider x:Name="WidthSlider" Grid.Column="1" Style="{StaticResource ThemedSlider}"
                            Minimum="20" Maximum="150" SmallChange="1" LargeChange="5"
                            TickFrequency="1" IsSnapToTickEnabled="True" VerticalAlignment="Center"
                            Margin="0,0,14,0" ValueChanged="WidthSlider_Changed"
                            AutomationProperties.Name="Bar width"/>
                    <ContentControl x:Name="WidthChip" Grid.Column="2" Style="{StaticResource ValueChip}"
                                    Content="34 px" VerticalAlignment="Center"/>
                </Grid>
            </Border>

            <Border Style="{StaticResource SettingsRow}">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock Text="Link left / right" Style="{StaticResource RowLabelText}"/>
                        <TextBlock Text="Mirror both bars around the screen center."
                                   Style="{StaticResource RowHelperText}"/>
                    </StackPanel>
                    <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                        <TextBlock x:Name="LinkStateLabel" Text="On" Style="{StaticResource ToggleStateOnText}"
                                   VerticalAlignment="Center" Margin="0,0,10,0"/>
                        <CheckBox x:Name="LinkToggle" Style="{StaticResource ToggleSwitch}"
                                  AutomationProperties.Name="Link left and right positions"
                                  Checked="LinkToggle_Changed" Unchecked="LinkToggle_Changed"/>
                    </StackPanel>
                </Grid>
            </Border>

            <Border x:Name="SpreadRow" Style="{StaticResource SettingsRow}">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="220"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock Text="Spread" Style="{StaticResource RowLabelText}"/>
                        <TextBlock Text="Distance between the two bars." Style="{StaticResource RowHelperText}"/>
                    </StackPanel>
                    <Slider x:Name="SpreadSlider" Grid.Column="1" Style="{StaticResource ThemedSlider}"
                            Minimum="10" Maximum="100" SmallChange="1" LargeChange="5"
                            TickFrequency="1" IsSnapToTickEnabled="True" VerticalAlignment="Center"
                            Margin="0,0,14,0" ValueChanged="SpreadSlider_Changed"
                            AutomationProperties.Name="Spread"/>
                    <ContentControl x:Name="SpreadChip" Grid.Column="2" Style="{StaticResource ValueChip}"
                                    Content="30 %" VerticalAlignment="Center"/>
                </Grid>
            </Border>

            <StackPanel x:Name="UnlinkedRows">
                <Border Style="{StaticResource SettingsRow}">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="220"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="Left position" Style="{StaticResource RowLabelText}" VerticalAlignment="Center"/>
                        <Slider x:Name="LeftSlider" Grid.Column="1" Style="{StaticResource ThemedSlider}"
                                Minimum="0" Maximum="45" SmallChange="1" LargeChange="5"
                                TickFrequency="1" IsSnapToTickEnabled="True" VerticalAlignment="Center"
                                Margin="0,0,14,0" ValueChanged="LeftSlider_Changed"
                                AutomationProperties.Name="Left position"/>
                        <ContentControl x:Name="LeftChip" Grid.Column="2" Style="{StaticResource ValueChip}"
                                        Content="35 %" VerticalAlignment="Center"/>
                    </Grid>
                </Border>
                <Border Style="{StaticResource SettingsRow}">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="220"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="Right position" Style="{StaticResource RowLabelText}" VerticalAlignment="Center"/>
                        <Slider x:Name="RightSlider" Grid.Column="1" Style="{StaticResource ThemedSlider}"
                                Minimum="55" Maximum="100" SmallChange="1" LargeChange="5"
                                TickFrequency="1" IsSnapToTickEnabled="True" VerticalAlignment="Center"
                                Margin="0,0,14,0" ValueChanged="RightSlider_Changed"
                                AutomationProperties.Name="Right position"/>
                        <ContentControl x:Name="RightChip" Grid.Column="2" Style="{StaticResource ValueChip}"
                                        Content="65 %" VerticalAlignment="Center"/>
                    </Grid>
                </Border>
            </StackPanel>
        </StackPanel>

        <!-- Radar ring / Compass anchor -->
        <Border x:Name="AnchorRow" Style="{StaticResource SettingsRow}">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <TextBlock Text="Anchor" Style="{StaticResource RowLabelText}" VerticalAlignment="Center"/>
                <ListBox x:Name="AnchorSegmented" Grid.Column="1" Style="{StaticResource SegmentedControl}"
                         SelectionChanged="AnchorSegmented_Changed"
                         AutomationProperties.Name="Anchor">
                    <ListBoxItem Content="None" Tag="None"/>
                    <ListBoxItem Content="Bottom" Tag="Bottom"/>
                    <ListBoxItem Content="Top" Tag="Top"/>
                </ListBox>
            </Grid>
        </Border>

        <!-- Ring ping rows -->
        <StackPanel x:Name="RingPingRows">
            <Border Style="{StaticResource SettingsRow}">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="Rings" Style="{StaticResource RowLabelText}" VerticalAlignment="Center"/>
                    <ListBox x:Name="RingsSegmented" Grid.Column="1" Style="{StaticResource SegmentedControl}"
                             SelectionChanged="RingsSegmented_Changed"
                             AutomationProperties.Name="Ring count">
                        <ListBoxItem Content="3" Tag="3"/>
                        <ListBoxItem Content="5" Tag="5"/>
                        <ListBoxItem Content="7" Tag="7"/>
                    </ListBox>
                </Grid>
            </Border>
            <Border Style="{StaticResource SettingsRow}">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock Text="Ring mapping" Style="{StaticResource RowLabelText}"/>
                        <TextBlock Text="Distance: loud sounds hit the inner ring. Meter: rings fill outward like a level meter."
                                   Style="{StaticResource RowHelperText}" MaxWidth="330"/>
                    </StackPanel>
                    <ListBox x:Name="MappingSegmented" Grid.Column="1" Style="{StaticResource SegmentedControl}"
                             VerticalAlignment="Center" SelectionChanged="MappingSegmented_Changed"
                             AutomationProperties.Name="Ring mapping">
                        <ListBoxItem Content="Distance" Tag="Distance"/>
                        <ListBoxItem Content="Meter" Tag="Meter"/>
                    </ListBox>
                </Grid>
            </Border>
        </StackPanel>

        <!-- Edge glow note -->
        <Border x:Name="EdgeGlowNote" Style="{StaticResource SettingsRow}">
            <TextBlock Text="Hugs all four edges — nothing to move or spread."
                       Style="{StaticResource RowHelperText}" VerticalAlignment="Center"/>
        </Border>

        <!-- Buttons -->
        <StackPanel Orientation="Horizontal" Margin="0,16,0,10">
            <Button x:Name="EditPositionsButton" Content="Edit positions on screen"
                    Style="{StaticResource PrimaryButton}" Click="EditPositions_Click"/>
            <TextBlock Text="Ctrl+Shift+E" FontFamily="{StaticResource MonoFont}" FontSize="11"
                       Foreground="{StaticResource TextMuted}" VerticalAlignment="Center" Margin="10,0,20,0"/>
            <Button x:Name="ResetButton" Content="Reset" Style="{StaticResource SecondaryButton}"
                    Click="Reset_Click"/>
            <TextBlock Text="Ctrl+Shift+P" FontFamily="{StaticResource MonoFont}" FontSize="11"
                       Foreground="{StaticResource TextMuted}" VerticalAlignment="Center" Margin="10,0,0,0"/>
        </StackPanel>
    </StackPanel>
</UserControl>
