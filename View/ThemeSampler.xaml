<Window x:Class="DeafDirectionalHelper.View.ThemeSampler"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Theme sampler (dev only)"
        Width="760" Height="820"
        Background="{StaticResource Bg}"
        WindowStartupLocation="CenterScreen">

    <!-- Dev-only window: renders every Phase 0 control in its states so the
         token/template spec can be verified visually and with the keyboard.
         Launch with the "-themesampler" command-line flag. -->

    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="26" >

            <TextBlock Text="Theme sampler" Style="{StaticResource PageTitleText}"/>
            <TextBlock Text="Every Phase 0 control in rest / hover / focused / disabled. Tab through everything: the yellow focus ring must always be visible."
                       Style="{StaticResource PageSubtitleText}" Margin="0,4,0,18" TextWrapping="Wrap"/>

            <!-- Typography -->
            <TextBlock Text="TYPOGRAPHY" Style="{StaticResource SectionLabelText}" Margin="0,0,0,8"/>
            <Border Background="{StaticResource Panel}" BorderBrush="{StaticResource Border}"
                    BorderThickness="1" CornerRadius="10" Padding="16" Margin="0,0,0,18">
                <StackPanel>
                    <TextBlock Text="Page title 24 Bold" Style="{StaticResource PageTitleText}"/>
                    <TextBlock Text="Page subtitle 13.5 Secondary" Style="{StaticResource PageSubtitleText}"/>
                    <TextBlock Text="SECTION LABEL 13 BOLD" Style="{StaticResource SectionLabelText}" Margin="0,8,0,0"/>
                    <TextBlock Text="Row label 15.5" Style="{StaticResource RowLabelText}" Margin="0,8,0,0"/>
                    <TextBlock Text="Row helper 13 Secondary" Style="{StaticResource RowHelperText}"/>
                    <TextBlock Text="Control text 14.5" Style="{StaticResource ControlText}" Margin="0,8,0,0"/>
                </StackPanel>
            </Border>

            <!-- Buttons -->
            <TextBlock Text="BUTTONS" Style="{StaticResource SectionLabelText}" Margin="0,0,0,8"/>
            <WrapPanel Margin="0,0,0,10">
                <Button Content="Primary" Style="{StaticResource PrimaryButton}" Margin="0,0,10,10"/>
                <Button Content="Secondary" Style="{StaticResource SecondaryButton}" Margin="0,0,10,10"/>
                <Button Content="Danger fill" Style="{StaticResource DangerButton}" Margin="0,0,10,10"/>
                <Button Content="Danger link" Style="{StaticResource DangerLinkButton}" Margin="0,0,10,10" VerticalAlignment="Center"/>
                <Button Content="Link" Style="{StaticResource LinkButton}" Margin="0,0,10,10" VerticalAlignment="Center"/>
            </WrapPanel>
            <WrapPanel Margin="0,0,0,18">
                <Button Content="Primary disabled" Style="{StaticResource PrimaryButton}" IsEnabled="False" Margin="0,0,10,0"/>
                <Button Content="Secondary disabled" Style="{StaticResource SecondaryButton}" IsEnabled="False" Margin="0,0,10,0"/>
            </WrapPanel>

            <!-- Toggle switches -->
            <TextBlock Text="TOGGLE SWITCH" Style="{StaticResource SectionLabelText}" Margin="0,0,0,8"/>
            <StackPanel Orientation="Horizontal" Margin="0,0,0,18">
                <CheckBox x:Name="ToggleOn" Style="{StaticResource ToggleSwitch}" IsChecked="True"/>
                <TextBlock Text="On" Style="{StaticResource ToggleStateOnText}" Margin="10,0,26,0" VerticalAlignment="Center"/>
                <CheckBox Style="{StaticResource ToggleSwitch}"/>
                <TextBlock Text="Off" Style="{StaticResource ToggleStateOffText}" Margin="10,0,26,0" VerticalAlignment="Center"/>
                <CheckBox Style="{StaticResource ToggleSwitch}" IsChecked="True" IsEnabled="False"/>
                <TextBlock Text="Disabled" Style="{StaticResource ToggleStateOffText}" Margin="10,0,0,0" VerticalAlignment="Center"/>
            </StackPanel>

            <!-- Segmented control -->
            <TextBlock Text="SEGMENTED CONTROL" Style="{StaticResource SectionLabelText}" Margin="0,0,0,8"/>
            <ListBox Style="{StaticResource SegmentedControl}" SelectedIndex="0"
                     HorizontalAlignment="Left" Margin="0,0,0,18">
                <ListBoxItem Content="Switch silently"/>
                <ListBoxItem Content="Switch + toast"/>
                <ListBoxItem Content="Ask first"/>
            </ListBox>

            <!-- Slider + value chip -->
            <TextBlock Text="SLIDER + VALUE CHIP" Style="{StaticResource SectionLabelText}" Margin="0,0,0,8"/>
            <Grid Margin="0,0,0,18">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <Slider x:Name="SampleSlider" Style="{StaticResource ThemedSlider}"
                        Minimum="0.1" Maximum="3.0" Value="1.0" SmallChange="0.1" LargeChange="0.1"
                        IsSnapToTickEnabled="True" TickFrequency="0.1"/>
                <ContentControl Grid.Column="1" Style="{StaticResource ValueChip}" Margin="14,0,0,0"
                                Content="{Binding ElementName=SampleSlider, Path=Value}"
                                ContentStringFormat="F1"/>
            </Grid>

            <!-- ComboBox -->
            <TextBlock Text="COMBO BOX" Style="{StaticResource SectionLabelText}" Margin="0,0,0,8"/>
            <ComboBox Style="{StaticResource ThemedComboBox}" SelectedIndex="0"
                      HorizontalAlignment="Left" MinWidth="320" Margin="0,0,0,18">
                <ComboBoxItem Content="CABLE-C Input (VB-Audio Voicemeeter VAIO) · 8 ch"/>
                <ComboBoxItem Content="Headphones (Realtek USB Audio) · 2 ch"/>
                <ComboBoxItem Content="Speakers (High Definition Audio) · 2 ch"/>
            </ComboBox>

            <!-- Radio cards -->
            <TextBlock Text="RADIO CARDS" Style="{StaticResource SectionLabelText}" Margin="0,0,0,8"/>
            <StackPanel Margin="0,0,0,18">
                <RadioButton Style="{StaticResource RadioCard}" GroupName="Capture" IsChecked="True" Margin="0,0,0,10">
                    <StackPanel>
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="Follow the game" Style="{StaticResource RowLabelText}" FontWeight="SemiBold"/>
                            <ContentControl Style="{StaticResource Pill}" Content="RECOMMENDED"
                                            Background="{StaticResource Success}" Foreground="{StaticResource OnSuccess}"
                                            Margin="10,0,0,0" VerticalAlignment="Center"/>
                        </StackPanel>
                        <TextBlock Text="Reads the game's own audio session on whichever device it plays to."
                                   Style="{StaticResource RowHelperText}" Margin="0,4,0,0"/>
                    </StackPanel>
                </RadioButton>
                <RadioButton Style="{StaticResource RadioCard}" GroupName="Capture">
                    <StackPanel>
                        <TextBlock Text="Windows default device" Style="{StaticResource RowLabelText}" FontWeight="SemiBold"/>
                        <TextBlock Text="Follows whatever Windows is playing to."
                                   Style="{StaticResource RowHelperText}" Margin="0,4,0,0"/>
                    </StackPanel>
                </RadioButton>
            </StackPanel>

            <!-- Kbd chips + pills -->
            <TextBlock Text="KBD CHIPS + PILLS" Style="{StaticResource SectionLabelText}" Margin="0,0,0,8"/>
            <WrapPanel Margin="0,0,0,18">
                <ContentControl Style="{StaticResource KbdChip}" Content="Ctrl+Shift+S" Margin="0,0,10,0"/>
                <ContentControl Style="{StaticResource KbdChip}" Content="Ctrl+Shift+M" Margin="0,0,26,0"/>
                <ContentControl Style="{StaticResource Pill}" Content="★ DEFAULT" VerticalAlignment="Center" Margin="0,0,10,0"/>
                <ContentControl Style="{StaticResource Pill}" Content="RUNNING NOW"
                                Background="{StaticResource Success}" Foreground="{StaticResource OnSuccess}"
                                VerticalAlignment="Center" Margin="0,0,10,0"/>
                <ContentControl Style="{StaticResource Pill}" Content="2 CH · STEREO"
                                Background="{StaticResource Warn}" Foreground="{StaticResource OnWarn}"
                                VerticalAlignment="Center"/>
            </WrapPanel>

            <!-- Doctor banner colors -->
            <TextBlock Text="SIGNAL DOCTOR BANNER" Style="{StaticResource SectionLabelText}" Margin="0,0,0,8"/>
            <Border Background="{StaticResource DoctorBannerBg}" BorderBrush="{StaticResource DoctorBannerBorder}"
                    BorderThickness="0,0,0,1" Padding="16,12" CornerRadius="8">
                <TextBlock Style="{StaticResource RowHelperText}" Foreground="{StaticResource DoctorBannerText}" TextWrapping="Wrap">
                    <Run Text="Overlay armed but silent." FontWeight="Bold" Foreground="{StaticResource DoctorBannerStrong}"/>
                    <Run Text="game.exe has been playing audio for 12 s, but none of it reached the device you're listening to."/>
                </TextBlock>
            </Border>

        </StackPanel>
    </ScrollViewer>
</Window>
