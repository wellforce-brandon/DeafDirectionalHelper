<Window x:Class="DeafDirectionalHelper.View.FirstRunWizard"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Welcome to DeafDirectionalHelper"
        Width="620" SizeToContent="Height"
        Background="{StaticResource Bg}"
        WindowStartupLocation="CenterScreen"
        ResizeMode="NoResize">

    <StackPanel Margin="28,24">

        <!-- Progress: three pills + STEP N OF 3 -->
        <Grid Margin="0,0,0,18">
            <StackPanel Orientation="Horizontal">
                <Border x:Name="Pill1" Width="28" Height="8" CornerRadius="4"
                        Background="{StaticResource Interactive}" Margin="0,0,6,0"/>
                <Border x:Name="Pill2" Width="28" Height="8" CornerRadius="4"
                        Background="{StaticResource Border}" Margin="0,0,6,0"/>
                <Border x:Name="Pill3" Width="28" Height="8" CornerRadius="4"
                        Background="{StaticResource Border}"/>
            </StackPanel>
            <TextBlock x:Name="StepLabel" Text="STEP 1 OF 3"
                       FontFamily="{StaticResource MonoFont}" FontSize="12"
                       Foreground="{StaticResource TextMuted}" HorizontalAlignment="Right"/>
        </Grid>

        <!-- Step 1: device -->
        <StackPanel x:Name="Step1">
            <TextBlock Text="Pick the audio device to listen to" Style="{StaticResource PageTitleText}"/>
            <TextBlock Style="{StaticResource PageSubtitleText}" Margin="0,6,0,16" TextWrapping="Wrap"
                       Text="The app reads audio output levels only — the same data as the Windows volume mixer. It never touches game memory or files."/>
            <StackPanel x:Name="DeviceRows"/>
        </StackPanel>

        <!-- Step 2: style -->
        <StackPanel x:Name="Step2" Visibility="Collapsed">
            <TextBlock Text="Choose your overlay style" Style="{StaticResource PageTitleText}"/>
            <TextBlock Style="{StaticResource PageSubtitleText}" Margin="0,6,0,16"
                       Text="You can switch anytime with Ctrl+Shift+M."/>
            <StackPanel x:Name="StyleRows"/>
        </StackPanel>

        <!-- Step 3: hotkeys -->
        <StackPanel x:Name="Step3" Visibility="Collapsed">
            <TextBlock Text="Hotkeys" Style="{StaticResource PageTitleText}"/>
            <TextBlock Style="{StaticResource PageSubtitleText}" Margin="0,6,0,16"
                       Text="These work everywhere — even while a game has focus."/>
            <StackPanel x:Name="HotkeyRows"/>
        </StackPanel>

        <!-- Footer -->
        <Grid Margin="0,22,0,0">
            <Button x:Name="SkipButton" Content="Skip setup" Style="{StaticResource LinkButton}"
                    Foreground="{StaticResource TextSecondary}"
                    HorizontalAlignment="Left" VerticalAlignment="Center" Click="Skip_Click"/>
            <Button x:Name="NextButton" Content="Next →" Style="{StaticResource PrimaryButton}"
                    HorizontalAlignment="Right" MinWidth="130" IsDefault="True" Click="Next_Click"/>
        </Grid>
    </StackPanel>
</Window>
