<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:po="http://schemas.microsoft.com/winfx/2006/xaml/presentation/options"
                    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
                    mc:Ignorable="po">

    <!-- ============================================================ -->
    <!-- Design tokens (IMPLEMENTATION_PLAN.md §1.1)                  -->
    <!-- Okabe-Ito colorblind-safe accents; AAA body text contrast.   -->
    <!-- State is never carried by color alone.                       -->
    <!-- ============================================================ -->

    <!-- Colors (for gradients, animations) -->
    <Color x:Key="BgColor">#0B0C0E</Color>
    <Color x:Key="PanelColor">#14161A</Color>
    <Color x:Key="RaisedColor">#1C2026</Color>
    <Color x:Key="HairlineColor">#23272E</Color>
    <Color x:Key="BorderColor">#2E333B</Color>
    <Color x:Key="BorderStrongColor">#454C57</Color>
    <Color x:Key="TextColor">#F4F5F7</Color>
    <Color x:Key="TextSecondaryColor">#A8AEB8</Color>
    <Color x:Key="TextMutedColor">#6E757F</Color>
    <Color x:Key="InteractiveColor">#56B4E9</Color>
    <Color x:Key="OnInteractiveColor">#04121D</Color>
    <Color x:Key="SuccessColor">#009E73</Color>
    <Color x:Key="OnSuccessColor">#02120C</Color>
    <Color x:Key="WarnColor">#E69F00</Color>
    <Color x:Key="OnWarnColor">#1A1200</Color>
    <Color x:Key="DangerColor">#D55E00</Color>
    <Color x:Key="OnDangerColor">#1A0A00</Color>
    <Color x:Key="DangerTextColor">#FF8A47</Color>
    <Color x:Key="FocusColor">#F0E442</Color>
    <Color x:Key="FooterBgColor">#0F1114</Color>
    <Color x:Key="DoctorBannerBgColor">#2A1F08</Color>
    <Color x:Key="DoctorBannerBorderColor">#4A3A10</Color>
    <Color x:Key="DoctorBannerTextColor">#F4E9C8</Color>
    <Color x:Key="DoctorBannerStrongColor">#FFD97A</Color>

    <!-- Brushes (primary consumption surface; frozen for perf) -->
    <SolidColorBrush x:Key="Bg" Color="#0B0C0E" po:Freeze="True"/>
    <SolidColorBrush x:Key="Panel" Color="#14161A" po:Freeze="True"/>
    <SolidColorBrush x:Key="Raised" Color="#1C2026" po:Freeze="True"/>
    <SolidColorBrush x:Key="Hairline" Color="#23272E" po:Freeze="True"/>
    <SolidColorBrush x:Key="Border" Color="#2E333B" po:Freeze="True"/>
    <SolidColorBrush x:Key="BorderStrong" Color="#454C57" po:Freeze="True"/>
    <SolidColorBrush x:Key="Text" Color="#F4F5F7" po:Freeze="True"/>
    <SolidColorBrush x:Key="TextSecondary" Color="#A8AEB8" po:Freeze="True"/>
    <SolidColorBrush x:Key="TextMuted" Color="#6E757F" po:Freeze="True"/>
    <SolidColorBrush x:Key="Interactive" Color="#56B4E9" po:Freeze="True"/>
    <SolidColorBrush x:Key="OnInteractive" Color="#04121D" po:Freeze="True"/>
    <SolidColorBrush x:Key="Success" Color="#009E73" po:Freeze="True"/>
    <SolidColorBrush x:Key="OnSuccess" Color="#02120C" po:Freeze="True"/>
    <SolidColorBrush x:Key="Warn" Color="#E69F00" po:Freeze="True"/>
    <SolidColorBrush x:Key="OnWarn" Color="#1A1200" po:Freeze="True"/>
    <SolidColorBrush x:Key="Danger" Color="#D55E00" po:Freeze="True"/>
    <SolidColorBrush x:Key="OnDanger" Color="#1A0A00" po:Freeze="True"/>
    <SolidColorBrush x:Key="DangerText" Color="#FF8A47" po:Freeze="True"/>
    <SolidColorBrush x:Key="Focus" Color="#F0E442" po:Freeze="True"/>
    <SolidColorBrush x:Key="FooterBg" Color="#0F1114" po:Freeze="True"/>
    <SolidColorBrush x:Key="DoctorBannerBg" Color="#2A1F08" po:Freeze="True"/>
    <SolidColorBrush x:Key="DoctorBannerBorder" Color="#4A3A10" po:Freeze="True"/>
    <SolidColorBrush x:Key="DoctorBannerText" Color="#F4E9C8" po:Freeze="True"/>
    <SolidColorBrush x:Key="DoctorBannerStrong" Color="#FFD97A" po:Freeze="True"/>

    <!-- Typography (§1.2) -->
    <FontFamily x:Key="UiFont">Segoe UI</FontFamily>
    <FontFamily x:Key="MonoFont">Consolas</FontFamily>

    <!-- Corner radii -->
    <CornerRadius x:Key="RadiusControl">8</CornerRadius>
    <CornerRadius x:Key="RadiusSegmentOption">6</CornerRadius>
    <CornerRadius x:Key="RadiusCard">10</CornerRadius>
    <CornerRadius x:Key="RadiusPill">12</CornerRadius>
    <CornerRadius x:Key="RadiusToggle">16</CornerRadius>

    <!-- Text styles -->
    <Style x:Key="WindowChromeTitleText" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource UiFont}"/>
        <Setter Property="FontSize" Value="12.5"/>
        <Setter Property="Foreground" Value="{StaticResource Text}"/>
    </Style>

    <Style x:Key="PageTitleText" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource UiFont}"/>
        <Setter Property="FontSize" Value="24"/>
        <Setter Property="FontWeight" Value="Bold"/>
        <Setter Property="Foreground" Value="{StaticResource Text}"/>
    </Style>

    <Style x:Key="PageSubtitleText" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource UiFont}"/>
        <Setter Property="FontSize" Value="13.5"/>
        <Setter Property="Foreground" Value="{StaticResource TextSecondary}"/>
    </Style>

    <!-- ALL-CAPS supplied by content; WPF has no letter-spacing property -->
    <Style x:Key="SectionLabelText" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource UiFont}"/>
        <Setter Property="FontSize" Value="13"/>
        <Setter Property="FontWeight" Value="Bold"/>
        <Setter Property="Foreground" Value="{StaticResource TextSecondary}"/>
    </Style>

    <Style x:Key="RowLabelText" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource UiFont}"/>
        <Setter Property="FontSize" Value="15.5"/>
        <Setter Property="Foreground" Value="{StaticResource Text}"/>
    </Style>

    <Style x:Key="RowHelperText" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource UiFont}"/>
        <Setter Property="FontSize" Value="13"/>
        <Setter Property="Foreground" Value="{StaticResource TextSecondary}"/>
        <Setter Property="TextWrapping" Value="Wrap"/>
    </Style>

    <Style x:Key="ControlText" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource UiFont}"/>
        <Setter Property="FontSize" Value="14.5"/>
        <Setter Property="Foreground" Value="{StaticResource Text}"/>
    </Style>

    <Style x:Key="ValueChipText" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource MonoFont}"/>
        <Setter Property="FontSize" Value="15"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
        <Setter Property="Foreground" Value="{StaticResource Text}"/>
    </Style>

</ResourceDictionary>
